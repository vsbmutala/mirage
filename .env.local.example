# ── MPEER environment ──────────────────────────────────────────────────────
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# Everything is optional — without keys the app runs in degraded mode
# (in-memory store, heuristic matching, no LLM/vision/search).

# LLM provider — OpenRouter (preferred) or OpenAI. One key is enough.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
# Model ids — OpenRouter uses vendor-prefixed ids (e.g. openai/gpt-4o-mini,
# anthropic/claude-sonnet-4.5, google/gemini-2.5-flash). Must support JSON
# output; the vision model must accept image inputs.
LLM_MODEL=openai/gpt-4o-mini
LLM_VISION_MODEL=openai/gpt-4o-mini

# Supabase — persistent storage (server-side only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web search provider — one of tavily / serper / brave (or "auto" to detect
# from the URL, "mock" to disable live search)
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
# Tavily:  https://api.tavily.com/search
# Serper:  https://google.serper.dev/search
# Brave:   https://api.search.brave.com/res/v1/web/search
SEARCH_API_URL=

# GitHub — optional; raises API rate limits for user/repo lookups
GITHUB_TOKEN=

# ORCID — optional; the public API is used without credentials today
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
